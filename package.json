{
  "name": "zonely",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "description": "Automatically changes browser timezone to match your IP's location.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'tests/*.test.cjs'",
    "test:smoke": "pnpm build && node tests/browser-smoke.cjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "packageManager": "pnpm@12.11.2"
}
